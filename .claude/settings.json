{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npm run *)", "Bash(npx vitest *)", "Bash(npx tsc *)", "Bash(npx eslint *)",
      "Bash(npx playwright *)", "Bash(npm view *)", "Bash(npm ls *)",
      "Bash(python3 *)", "Bash(python *)", "Bash(.venv/bin/python *)", "Bash(.venv/bin/pip install -r *)",
      "Bash(make *)", "Bash(unzip *)", "Bash(ls *)", "Bash(mkdir *)", "Bash(file *)",
      "Bash(git init*)", "Bash(git status*)", "Bash(git diff*)", "Bash(git log*)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git branch*)", "Bash(git remote -v)",
      "Bash(gh auth status*)", "Bash(gh repo view*)"
    ],
    "ask": [
      "Bash(git push *)", "Bash(gh repo create *)", "Bash(gh repo edit *)",
      "Bash(npm install *)", "Bash(npm i *)", "Bash(npm create *)",
      "Bash(vercel *)", "Bash(npx vercel *)", "Bash(rm *)", "Bash(curl *)"
    ],
    "deny": [
      "Bash(git push --force*)", "Bash(git push -f*)", "Bash(git reset --hard*)",
      "Bash(gh repo delete*)", "Bash(sudo *)",
      "Read(./.env)", "Read(./.env.*)", "Read(~/.ssh/**)"
    ]
  }
}
